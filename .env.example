# ─── Discord ────────────────────────────────────────────────────────────────
DISCORD_TOKEN=      # Bot → Token
CLIENT_ID=          # OAuth2 → Client ID
CLIENT_SECRET=      # OAuth2 → Client Secret
GUILD_ID=           # Server ID (right-click server → Copy ID)
ADMIN_ROLE_ID=      # Role ID (right-click admin role → Copy ID)

# ─── Google Sheets ──────────────────────────────────────────────────────────
# Paste your service-account JSON key into google-credentials.json, then:
GOOGLE_CREDENTIALS_FILE=google-credentials.json
# (or inline as GOOGLE_CREDENTIALS={"type":"service_account",...})
GOOGLE_SHEET_ID=    # From sheet URL: /spreadsheets/d/<THIS>/edit

# ─── WebUI ────────────────────────────────────────────────────────────────────
SESSION_SECRET=     # Run: openssl rand -hex 32
BASE_URL=           # e.g. http://localhost:3000 or http://<tailscale-ip>:3000

# ─── Optional ────────────────────────────────────────────────────────────────
# PORT=3000
# WEBUI_PORT=3000
