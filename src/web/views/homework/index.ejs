<%
  const path = '/homework';
  const title = 'Homework';
  body = `
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--pico-spacing)">
  <button onclick="showAddModal()">+ Add Homework</button>
  <div>
    <select id="filterSubject" onchange="filterTable()" style="display:inline-block;width:auto;margin:0">
      <option value="">All Subjects</option>
      ${subjects.map(s => `<option value="${s.subjectCode}">${s.subjectCode}</option>`).join('')}
    </select>
    <span><strong>${homework.length}</strong> total</span>
  </div>
</div>

<table id="hwTable">
  <thead><tr><th>ID</th><th>Subject</th><th>Title</th><th>Due Date</th><th>Actions</th></tr></thead>
  <tbody>
    ${homework.map(h => `
      <tr data-subject="${h.subjectCode}">
        <td class="truncate"><code>${h.homeworkId}</code></td>
        <td>${h.subjectCode}</td>
        <td class="truncate">${h.title}</td>
        <td>${h.dueDate || '-'}</td>
        <td>
          <div class="inline-flex">
            <button class="outline secondary" style="padding:4px 10px;font-size:0.8rem" onclick="editHomework('${h.homeworkId}','${h.subjectCode}','${h.title.replace(/'/g, "\\'")}','${(h.details||'').replace(/'/g, "\\'")}','${(h.link||'').replace(/'/g, "\\'")}','${h.dueDate||''}')">Edit</button>
            <button class="outline" style="padding:4px 10px;font-size:0.8rem" onclick="deleteHomework('${h.homeworkId}')">Delete</button>
          </div>
        </td>
      </tr>
    `).join('')}
  </tbody>
</table>

<div id="hwModal" class="modal-overlay" style="display:none">
  <div class="modal-content">
    <h2 id="hwModalTitle">Add Homework</h2>
    <input type="hidden" id="hwEditId">
    <label>Subject
      <select id="hwSubject">
        ${subjects.map(s => `<option value="${s.subjectCode}">${s.subjectCode} — ${s.subjectName}</option>`).join('')}
      </select>
    </label>
    <label>Title <input type="text" id="hwTitle" required></label>
    <label>Details <textarea id="hwDetails" rows="2"></textarea></label>
    <label>Link <input type="url" id="hwLink" placeholder="https://..."></label>
    <label>Due Date <input type="datetime-local" id="hwDueDate" required></label>
    <div style="display:flex;gap:8px;margin-top:var(--pico-spacing)">
      <button onclick="saveHomework()">Save</button>
      <button class="secondary" onclick="closeModal()">Cancel</button>
    </div>
  </div>
</div>

<script>
let editingHwId = null;

function showAddModal() {
  editingHwId = null;
  document.getElementById('hwModalTitle').textContent = 'Add Homework';
  document.getElementById('hwSubject').value = subjects.length > 0 ? subjects[0].subjectCode : '';
  document.getElementById('hwTitle').value = '';
  document.getElementById('hwDetails').value = '';
  document.getElementById('hwLink').value = '';
  document.getElementById('hwDueDate').value = '';
  document.getElementById('hwModal').style.display = 'flex';
}

function editHomework(id, subject, title, details, link, dueDate) {
  editingHwId = id;
  document.getElementById('hwModalTitle').textContent = 'Edit ' + id;
  document.getElementById('hwSubject').value = subject;
  document.getElementById('hwTitle').value = title;
  document.getElementById('hwDetails').value = details;
  document.getElementById('hwLink').value = link;
  document.getElementById('hwDueDate').value = dueDate ? dueDate.replace(' ', 'T') : '';
  document.getElementById('hwModal').style.display = 'flex';
}

async function saveHomework() {
  const subject = document.getElementById('hwSubject').value;
  const title = document.getElementById('hwTitle').value.trim();
  const details = document.getElementById('hwDetails').value.trim();
  const link = document.getElementById('hwLink').value.trim();
  const dueDate = document.getElementById('hwDueDate').value;
  if (!title || !dueDate) return alert('Title and due date required');

  const body = { subjectCode: subject, title, details, link, dueDate: dueDate.replace('T', ' ') };

  if (editingHwId) {
    const res = await fetch('/api/homework/' + editingHwId, {
      method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify(body)
    });
    if (res.ok) location.reload();
    else { const d = await res.json(); alert('Error: ' + d.error); }
  } else {
    const res = await fetch('/api/homework', {
      method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(body)
    });
    if (res.ok) location.reload();
    else { const d = await res.json(); alert('Error: ' + d.error); }
  }
}

async function deleteHomework(id) {
  if (!confirm('Delete ' + id + '?')) return;
  const res = await fetch('/api/homework/' + id, { method: 'DELETE' });
  if (res.ok) location.reload();
  else { const d = await res.json(); alert('Error: ' + d.error); }
}

function filterTable() {
  const val = document.getElementById('filterSubject').value;
  document.querySelectorAll('#hwTable tbody tr').forEach(r => {
    r.style.display = !val || r.dataset.subject === val ? '' : 'none';
  });
}

function closeModal() { document.getElementById('hwModal').style.display = 'none'; }
</script>
`%>
<%- include('../layout', { user, path, title, body, error }) %>
