<%
  const path = '/users';
  const title = 'Users';
  body = `
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--pico-spacing)">
  <input type="text" id="searchInput" placeholder="Search by name, student ID, or Discord ID..." style="max-width:400px;margin:0">
  <span><strong>${users.length}</strong> total</span>
</div>

<table id="usersTable">
  <thead><tr><th>Discord ID</th><th>First Name</th><th>Last Name</th><th>Student ID</th><th>Actions</th></tr></thead>
  <tbody>
    ${users.map(u => `
      <tr>
        <td class="truncate">${u.discordId || ''}</td>
        <td>${u.firstName || ''}</td>
        <td>${u.lastName || ''}</td>
        <td><code>${u.studentId || ''}</code></td>
        <td>
          <div class="inline-flex">
            <button class="outline secondary" style="padding:4px 10px;font-size:0.8rem" onclick="changePw('${u.studentId}','${u.firstName} ${u.lastName}')">Change Password</button>
            <button class="outline" style="padding:4px 10px;font-size:0.8rem" onclick="removeUser('${u.studentId}','${u.firstName} ${u.lastName}')">Remove</button>
          </div>
        </td>
      </tr>
    `).join('')}
  </tbody>
</table>

<div id="pwModal" class="modal-overlay" style="display:none">
  <div class="modal-content">
    <h2>Change Password</h2>
    <p>User: <strong id="pwUserName"></strong></p>
    <input type="password" id="newPassword" placeholder="New password" minlength="6">
    <div style="display:flex;gap:8px;margin-top:var(--pico-spacing)">
      <button onclick="submitChangePw()">Save</button>
      <button class="secondary" onclick="closeModal()">Cancel</button>
    </div>
  </div>
</div>

<script>
let changingStudentId = '';
function changePw(studentId, name) {
  changingStudentId = studentId;
  document.getElementById('pwUserName').textContent = name;
  document.getElementById('newPassword').value = '';
  document.getElementById('pwModal').style.display = 'flex';
}
async function submitChangePw() {
  const pw = document.getElementById('newPassword').value;
  if (!pw || pw.length < 6) return alert('Password must be at least 6 characters');
  const res = await fetch('/api/users/' + changingStudentId + '/password', {
    method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({ password: pw })
  });
  if (res.ok) { alert('Password changed!'); closeModal(); }
  else { const d = await res.json(); alert('Error: ' + d.error); }
}
async function removeUser(studentId, name) {
  if (!confirm('Remove ' + name + ' (' + studentId + ')?')) return;
  const res = await fetch('/api/users/' + studentId, { method: 'DELETE' });
  if (res.ok) location.reload();
  else { const d = await res.json(); alert('Error: ' + d.error); }
}
function closeModal() { document.getElementById('pwModal').style.display = 'none'; }
document.getElementById('searchInput')?.addEventListener('input', function() {
  const q = this.value.toLowerCase();
  document.querySelectorAll('#usersTable tbody tr').forEach(r => {
    r.style.display = r.textContent.toLowerCase().includes(q) ? '' : 'none';
  });
});
</script>
`%>
<%- include('../layout', { user, path, title, body, error }) %>
