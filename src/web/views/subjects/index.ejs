<%
  const path = '/subjects';
  const title = 'Subjects';
  body = `
<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:var(--pico-spacing)">
  <button onclick="showAddModal()">+ Add Subject</button>
  <span><strong>${subjects.length}</strong> total</span>
</div>

<table>
  <thead><tr><th>Code</th><th>Name</th><th>Credits</th><th>Instructor</th><th>Actions</th></tr></thead>
  <tbody>
    ${subjects.map(s => `
      <tr>
        <td><code>${s.subjectCode}</code></td>
        <td>${s.subjectName}</td>
        <td>${s.credits}</td>
        <td>${s.instructor}</td>
        <td>
          <div class="inline-flex">
            <button class="outline secondary" style="padding:4px 10px;font-size:0.8rem" onclick="editSubject('${s.subjectCode}','${s.subjectName}','${s.credits}','${s.instructor}')">Edit</button>
            <button class="outline" style="padding:4px 10px;font-size:0.8rem" onclick="deleteSubject('${s.subjectCode}')">Delete</button>
          </div>
        </td>
      </tr>
    `).join('')}
  </tbody>
</table>

<div id="subjectModal" class="modal-overlay" style="display:none">
  <div class="modal-content">
    <h2 id="subjectModalTitle">Add Subject</h2>
    <input type="hidden" id="editCode">
    <label>Subject Code <input type="text" id="sCode" placeholder="e.g. MTH101" required></label>
    <label>Subject Name <input type="text" id="sName" placeholder="e.g. Mathematics" required></label>
    <label>Credits <input type="number" id="sCredits" placeholder="3" required></label>
    <label>Instructor <input type="text" id="sInstructor" placeholder="e.g. John Doe" required></label>
    <div style="display:flex;gap:8px;margin-top:var(--pico-spacing)">
      <button onclick="saveSubject()">Save</button>
      <button class="secondary" onclick="closeModal()">Cancel</button>
    </div>
  </div>
</div>

<script>
let editingCode = null;

function showAddModal() {
  editingCode = null;
  document.getElementById('subjectModalTitle').textContent = 'Add Subject';
  document.getElementById('sCode').value = '';
  document.getElementById('sName').value = '';
  document.getElementById('sCredits').value = '';
  document.getElementById('sInstructor').value = '';
  document.getElementById('subjectModal').style.display = 'flex';
}

function editSubject(code, name, credits, instructor) {
  editingCode = code;
  document.getElementById('subjectModalTitle').textContent = 'Edit ' + code;
  document.getElementById('sCode').value = code;
  document.getElementById('sName').value = name;
  document.getElementById('sCredits').value = credits;
  document.getElementById('sInstructor').value = instructor;
  document.getElementById('subjectModal').style.display = 'flex';
}

async function saveSubject() {
  const code = document.getElementById('sCode').value.trim();
  const name = document.getElementById('sName').value.trim();
  const credits = document.getElementById('sCredits').value;
  const instructor = document.getElementById('sInstructor').value.trim();
  if (!code || !name || !credits || !instructor) return alert('Fill all fields');

  if (editingCode) {
    const res = await fetch('/api/subjects/' + editingCode, {
      method: 'PUT', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ subjectName: name, credits, instructor })
    });
    if (res.ok) location.reload();
    else { const d = await res.json(); alert('Error: ' + d.error); }
  } else {
    const res = await fetch('/api/subjects', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ subjectCode: code, subjectName: name, credits, instructor })
    });
    if (res.ok) location.reload();
    else { const d = await res.json(); alert('Error: ' + d.error); }
  }
}

async function deleteSubject(code) {
  if (!confirm('Delete ' + code + '?')) return;
  const res = await fetch('/api/subjects/' + code, { method: 'DELETE' });
  if (res.ok) location.reload();
  else { const d = await res.json(); alert('Error: ' + d.error); }
}

function closeModal() { document.getElementById('subjectModal').style.display = 'none'; }
</script>
`%>
<%- include('../layout', { user, path, title, body, error }) %>
